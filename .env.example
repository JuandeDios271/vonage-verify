# Puerto en el que correrá el servidor Express dentro del contenedor
PORT=3000

# Claves de API de Vonage
# Úsalas para enviar y verificar códigos SMS
VONAGE_API_KEY=tu_api_key
VONAGE_API_SECRET=tu_api_secret

# Nombre de marca en SMS de Vonage Verify API
VONAGE_VERIFY_BRAND=Traixo

# Credenciales del contenedor MongoDB (docker-compose)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambia_esta_contraseña

# URI de conexión a MongoDB (debe coincidir con MONGO_ROOT_USER / MONGO_ROOT_PASSWORD)
MONGO_URI=mongodb://root:cambia_esta_contraseña@mongo:27017/verifications?authSource=admin

# Orígenes permitidos para CORS (separados por coma)
# Agrega los dominios que usarán tu API (web, móvil, etc.)
CORS_ORIGINS=https://miapp.com,capacitor://localhost

# Credenciales para autenticación básica (ej. en endpoints protegidos)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=admin123

# Para desarrollo y monitoreo con docker logs (ej. debug, warn, error, http, info)
LOG_LEVEL=info